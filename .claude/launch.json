{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "canvas-harness",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--config",
        "harness/canvas/vite.config.ts"
      ],
      "port": 5199
    },
    {
