# Names only. Never commit real values. Set these as Manufact environment variables.

# ACCESS (one of the two is REQUIRED, otherwise tools/call is refused):
# BRAVE_SUBMITTER_API_KEY=            # authenticated mode: clients send "Authorization: Bearer <key>"
# BRAVE_SUBMITTER_ALLOW_PUBLIC=true   # public mode: anyone who can reach the endpoint can call the tool

# LIMITS (per server instance, in-memory; see README "Limits")
# BRAVE_SUBMITTER_MAX_CONCURRENT=1    # 1-3
# BRAVE_SUBMITTER_MAX_PER_HOUR=12     # 1-60
# BRAVE_SUBMITTER_DEDUPE_HOURS=24     # 1-168

# BROWSER
# BRAVE_SUBMITTER_NO_SANDBOX=1        # explicit opt-in only; disables Chromium's sandbox (see README)
# BRAVE_SUBMITTER_SELFCHECK=0         # skip the boot-time Chromium launch check

# DISCOVERY SUITE (all optional)
# PAGESPEED_API_KEY=            # enables the PageSpeed section of audit-site; unset = reported as "skipped". Off in the public deployment (see DECISIONS.md)
# CF_ANALYTICS_API_TOKEN=       # enables snapshot-cloudflare-baseline; use a read-only token (Zone > Analytics > Read) scoped to ONE zone you own

# CF_ZONE_IDS: comma-separated 32-hex zone ids callers may query. snapshot-cloudflare-baseline is only offered when this AND CF_ANALYTICS_API_TOKEN are set
# (the token can usually read every zone on the account, so callers are limited to this list).
# CF_ZONE_IDS=
