{
  "name": "brave-submitter",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "version": "1.0.0",
  "description": "MCP server exposing submit-brave-url: submits one URL to Brave Search via a real headless browser and reports what actually happened.",
  "author": "TAT Inc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tatinc23/brave-submitter.git"
  },
  "homepage": "https://github.com/tatinc23/brave-submitter#readme",
  "bugs": {
    "url": "https://github.com/tatinc23/brave-submitter/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "mcp-use",
    "manufact",
    "brave-search",
    "puppeteer"
  ],
  "scripts": {
    "build": "mcp-use build",
    "dev": "mcp-use dev",
    "start": "mcp-use start",
    "typecheck": "mcp-use typecheck",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "build:site": "node scripts/build-site.mjs",
    "typecheck:worker": "tsc -p deploy/mcp/tsconfig.json",
    "build:worker": "node scripts/build-worker.mjs",
    "deploy:worker": "node scripts/build-worker.mjs && cd deploy/mcp && npx wrangler@latest deploy",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "mcp-use": "2.11.2",
    "puppeteer": "^25.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.155.0"
  },
  "imports": {
    "#safe-fetch": {
      "workerd": "./src/worker/safe-fetch-default.ts",
      "default": "./src/safe-fetch.ts"
    }
  }
}
