{
  // Type-checks the Workers entry against the generated runtime types (npm run typecheck:worker).
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["workerd"],
    "lib": ["ES2024"],
    "types": ["./worker-configuration.d.ts"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx"
  },
  "include": ["../../src/worker/**/*.ts", "./worker-configuration.d.ts"]
}
