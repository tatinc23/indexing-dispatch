{
  "compilerOptions": {
    "target": "ES2024",
    "jsx": "react-jsx",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "index.ts",
    "mcp-env.d.ts",
    "src/**/*",
    "views/**/*",
    "test/**/*",
    ".mcp-use/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/worker/index.ts",
    "src/worker/limiter-do.ts",
    "src/worker/brave-browser-run.ts",
    "src/worker/generated"
  ]
}
